# Copy to .env and fill in — never commit .env to git
OPENAI_API_KEY=sk-...
# KUBECONFIG=/path/to/kubeconfig

# Server security (optional; the API is open by default for trusted networks).
# Set a shared secret to require X-API-Key/Bearer on /api/* requests:
# K8S_ADVISOR_SERVER__API_KEY=change-me
# Comma-separated CORS origins for a cross-origin browser UI (never "*"):
# K8S_ADVISOR_SERVER__CORS_ALLOW_ORIGINS=["https://ui.example"]
